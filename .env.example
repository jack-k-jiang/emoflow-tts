# Hugging Face Hub — needed to download F5-TTS / evaluation model checkpoints
HF_TOKEN=
HF_HOME=.cache/huggingface

# Torch hub cache (SpeechBrain / Whisper checkpoints)
TORCH_HOME=.cache/torch

# GPU selection — e.g. "0" or "0,1"; leave blank to use all visible devices
CUDA_VISIBLE_DEVICES=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
